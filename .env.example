# Copy to .env.local. Never put secrets in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Ambiguous: verified MCP endpoint and tool name. Add your key and calendar ID.
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp
AMBIGUOUS_API_KEY=
AMBIGUOUS_CALENDAR_TOOL=create_event
# JSON arguments matching the tool schema. Supported placeholders:
# {{title}}, {{start}}, {{end}}, {{timezone}}, {{description}}
# Replace YOUR_CALENDAR_ID with the default ID returned by list_calendars:
# AMBIGUOUS_CALENDAR_ARGS={"calendar_id":"YOUR_CALENDAR_ID","title":"{{title}}","start_at":"{{start}}","end_at":"{{end}}","description":"{{description}}","status":"tentative","visibility":"private","attendees":[],"auto_conference":false,"auto_meeting_notes":false}
AMBIGUOUS_CALENDAR_ARGS=

# Local single-user MVP. SQLite stores transcript text, not audio.
BIGBROTHER_DATA_DIR=./data
